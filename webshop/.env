STRIPE_PUBLISHABLE_KEY=pk_test_...
PAYPAL_CLIENT_ID=A...
PAYPAL_CLIENT_SECRET=E...
PAYPAL_MODE=sandbox
DOMAIN_URL=http://localhost:5000
# Nur fuer lokale Entwicklung/Tests: schaltet einen "Dummy-Kauf simulieren"-
# Button frei, der Stripe/PayPal komplett umgeht. Siehe CLAUDE.md, Abschnitt
# "Ausnahme (lokaler Dev-Schalter)". In Produktion IMMER auf false lassen.
DUMMY_MODE=false
# Pfad zum RSA-Schluesselpaar des Offline-Lizenzsystems (siehe
# tools/license_generator.py). Default: ../keys/ (Projekt-Root/keys), muss
# vorab per "python tools/license_generator.py generate-keys" erzeugt werden.
LICENSE_KEYS_DIR=
LICENSE_PRIVATE_KEY_PATH=
LICENSE_PUBLIC_KEY_PATH=
