[Unit]
Description=FPV Gamification Webshop
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/fpv-gamification-pico/webshop
EnvironmentFile=/opt/fpv-gamification-pico/webshop/.env
ExecStart=/usr/bin/python3 /opt/fpv-gamification-pico/webshop/serve_production.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target