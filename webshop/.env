FLASK_SECRET_KEY=geheim_schluessel_change_me
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
PAYPAL_CLIENT_ID=A...
PAYPAL_CLIENT_SECRET=E...
PAYPAL_MODE=sandbox
DOMAIN_URL=http://bollisoft.ch
# Nur fuer lokale Entwicklung/Tests: schaltet einen "Dummy-Kauf simulieren"-
# Button frei, der Stripe/PayPal komplett umgeht. Siehe CLAUDE.md, Abschnitt
# "Ausnahme (lokaler Dev-Schalter)". In Produktion IMMER auf false lassen.
DUMMY_MODE=true
# Pfad zum RSA-Schluesselpaar des Offline-Lizenzsystems (siehe
# tools/license_generator.py). Default: ../keys/ (Projekt-Root/keys), muss
# vorab per "python tools/license_generator.py generate-keys" erzeugt werden.
LICENSE_KEYS_DIR=
LICENSE_PRIVATE_KEY_PATH=
LICENSE_PUBLIC_KEY_PATH=
# Optionaler eigener Pfad fuer die Hardware-Bestellungen-Datenbank (siehe
# orders_db.py) - Default: webshop/orders.db, komplett getrennt von webshop.db.
WEBSHOP_ORDERS_DB_PATH=
# Zugangsdaten fuer den Admin-Bereich (/admin, kleiner Link unten rechts auf
# jeder Seite). Ohne gesetzte Werte bleibt der Admin-Bereich gesperrt. In
# Produktion unbedingt auf ein eigenes, starkes Passwort setzen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
